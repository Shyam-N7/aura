# Copy to .env.local (gitignored) and fill in. The server loads this file via
# `node --env-file=.env.local`. Every var below is required at boot.

# ── Database ──
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/aura

# ── Auth ──
# JWT signing secret — use a long random string, e.g. `openssl rand -hex 64`.
JWT_SECRET=
# Google OAuth client ID (optional; leave blank to disable Google sign-in). Set
# both to the same value — the server verifies the token, Vite exposes it to the browser.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── AI (Google Gemini) ──
# Powers "why this", talk, journal, sonic DNA, greetings, mood, lyric romanization.
# Leave blank to run without AI features (catalog + lyrics still work).
GEMINI_API_KEY=

# ── Transactional email (Resend) ──
# RESEND_API_KEY from resend.com; MAIL_FROM must be a verified sender. In dev,
# leave both blank and set MAIL_DEV_ECHO=1 to log OTP codes to the server console.
RESEND_API_KEY=
MAIL_FROM=
MAIL_DEV_ECHO=1

# ── Server ──
PORT=8787

# ── Upstream catalog provider ──
# Endpoint, media key, request methods + shape for the public web API you fetch
# the catalog from. Left blank on purpose so the committed repo carries no
# provider fingerprint — fill these in your local .env.local only.
CATALOG_API_BASE=
CATALOG_MEDIA_KEY=
CATALOG_BITRATE=320
CATALOG_USER_AGENT=Mozilla/5.0
CATALOG_CTX=
CATALOG_CTX_HOME=
CATALOG_API_VERSION=
CATALOG_AUDIO_SRC_QUALITY=
CATALOG_IMG_SRC_SIZE=
CATALOG_IMG_DEST_SIZE=
CATALOG_M_SEARCH=
CATALOG_M_SONG=
CATALOG_M_HOME=
CATALOG_M_PLAYLIST=
CATALOG_M_RECO=
CATALOG_M_LYRICS=
CATALOG_M_ARTIST=
CATALOG_M_ALBUM=
CATALOG_M_SUGGEST=

# ── Synced-lyrics provider (LRCLIB) ──
LYRICS_API_BASE=
LYRICS_USER_AGENT=
LYRICS_TIMEOUT_MS=15000

# ── Additional synced-lyrics providers (OPTIONAL — leave blank to skip) ──
# Musixmatch has the best coverage for Indian regional music (the biggest gap in
# this catalog). MUSIXMATCH_USERTOKEN is the free community token (sign in at
# musixmatch.com → grab the usertoken). CAVEAT: that desktop endpoint is NOT
# licensed for third-party redistribution — a ToS gray area, and the token can be
# revoked or rate-limited at any time. Treat it as best-effort; the compliant
# path is the official Musixmatch API. The chain runs LRCLIB → Musixmatch →
# NetEase and skips any provider left unconfigured.
MUSIXMATCH_USERTOKEN=
MUSIXMATCH_API_BASE=https://apic-desktop.musixmatch.com/ws/1.1/
MUSIXMATCH_TIMEOUT_MS=
# NetEase needs a self-hosted NeteaseCloudMusicApi base URL (no stable public
# endpoint). Weak for Indian songs; helps some English/CJK long-tail.
NETEASE_API_BASE=

# ── Lyrics generation worker (Replicate WhisperX) — OPTIONAL ──
# Off until BOTH REPLICATE_API_TOKEN and PUBLIC_BASE_URL are set. When on, songs
# with no synced match in any provider are transcribed-and-aligned from their
# audio (pay-per-use, ~1-4¢/song, charged once, cached forever). Audio is passed
# to Replicate by URL — never stored. PUBLIC_BASE_URL is your deployed origin so
# Replicate can call back the webhook (e.g. https://aurafm.live). The webhook +
# cron-reaper routes are guarded by these secrets.
REPLICATE_API_TOKEN=
REPLICATE_WHISPER_MODEL=victor-upmeet/whisperx
PUBLIC_BASE_URL=
# Webhook auth. Prefer REPLICATE_WEBHOOK_SIGNING_SECRET (whsec_…, from Replicate's
# `GET /v1/webhooks/default/secret`): the webhook is then verified by HMAC
# signature, so no secret rides in the callback URL (which Replicate logs). If
# that's unset, LYRICS_WEBHOOK_SECRET guards the webhook via a URL ?token= and is
# REQUIRED for the webhook to accept calls (an unset secret rejects, never opens).
LYRICS_WEBHOOK_SECRET=
REPLICATE_WEBHOOK_SIGNING_SECRET=
# Set CRON_SECRET in Vercel too so its daily cron (vercel.json) can authorize
# against /api/lyrics-jobs/process (CRON_SECRET is the ONLY accepted credential).
CRON_SECRET=
# Max generation jobs dispatched per rolling 24h (spend guard). Default 500.
LYRICS_GEN_DAILY_CAP=500
