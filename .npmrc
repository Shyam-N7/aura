# Install with npm's pre-v7 peer-dependency behavior (don't auto-install or
# hard-fail on peer conflicts). The devDependencies carry a known mismatch
# (@eslint/js@10 vs eslint@9, lint-only) that a local install tolerates but a
# clean CI install (Vercel) rejects with ERESOLVE. This makes CI install the
# exact lockfile tree the app already runs on. Does not affect the build.
legacy-peer-deps=true
