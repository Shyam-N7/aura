{
  "name": "aura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --watch --env-file=.env.local server/index.js",
    "migrate": "node server/migrate.js",
    "dev:all": "run-p dev server",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/hanken-grotesk": "^5.1.0",
    "@google/genai": "^2.3.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "5.2.0",
    "firebase-admin": "13.10.0",
    "google-auth-library": "^10.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.23",
    "pg": "^8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.4",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.1"
